// ============================================================
// DataCo — міри для таблиці _Міри
// Формат: Назва = вираз   // формат | папка відображення
// Факт: fЗамовлення (1 рядок = 1 позиція замовлення)
// ============================================================

// ---------- 1. Продажі ----------
Продажі = SUM ( 'fЗамовлення'[NetSales] )                                   // $#,0 | Продажі
Продажі брутто = SUM ( 'fЗамовлення'[GrossSales] )                          // $#,0 | Продажі
Знижки = SUM ( 'fЗамовлення'[Discount] )                                    // $#,0 | Продажі
% знижки = DIVIDE ( [Знижки], [Продажі брутто] )                            // 0.0% | Продажі
Прибуток = SUM ( 'fЗамовлення'[Profit] )                                    // $#,0 | Продажі
Маржа % = DIVIDE ( [Прибуток], [Продажі] )                                  // 0.0% | Продажі
Замовлення = DISTINCTCOUNT ( 'fЗамовлення'[OrderId] )                       // #,0 | Продажі
Позиції = COUNTROWS ( 'fЗамовлення' )                                       // #,0 | Продажі
Одиниці = SUM ( 'fЗамовлення'[Quantity] )                                   // #,0 | Продажі
Середній чек = DIVIDE ( [Продажі], [Замовлення] )                           // $#,0.00 | Продажі
Одиниць на замовлення = DIVIDE ( [Одиниці], [Замовлення] )                  // 0.00 | Продажі

// ---------- 2. Динаміка ----------
Продажі ПР = CALCULATE ( [Продажі], SAMEPERIODLASTYEAR ( 'Календар'[Date] ) )      // $#,0 | Динаміка
Продажі р/р % = DIVIDE ( [Продажі] - [Продажі ПР], [Продажі ПР] )                  // +0.0%;-0.0% | Динаміка
Прибуток ПР = CALCULATE ( [Прибуток], SAMEPERIODLASTYEAR ( 'Календар'[Date] ) )    // $#,0 | Динаміка
Прибуток р/р % = DIVIDE ( [Прибуток] - [Прибуток ПР], [Прибуток ПР] )              // +0.0%;-0.0% | Динаміка
Замовлення ПР = CALCULATE ( [Замовлення], SAMEPERIODLASTYEAR ( 'Календар'[Date] ) ) // #,0 | Динаміка
Замовлення р/р % = DIVIDE ( [Замовлення] - [Замовлення ПР], [Замовлення ПР] )      // +0.0%;-0.0% | Динаміка
Продажі YTD = TOTALYTD ( [Продажі], 'Календар'[Date] )                             // $#,0 | Динаміка

// ---------- 3. Доставка і сервіс (рахуємо по замовленнях, не по позиціях) ----------
Відвантажені замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[IsShipped] = 1 )                       // #,0 | Доставка
Запізнілі замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[IsLate] = 1 )                             // #,0 | Доставка
% запізнень = DIVIDE ( [Запізнілі замовлення], [Відвантажені замовлення] )                               // 0.0% | Доставка
Вчасні замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[DeliveryStatus] = "Shipping on time" )       // #,0 | Доставка
Дострокові замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[DeliveryStatus] = "Advance shipping" )   // #,0 | Доставка
% вчасно (OTD) = DIVIDE ( [Вчасні замовлення] + [Дострокові замовлення], [Відвантажені замовлення] )     // 0.0% | Доставка
Ціль OTD = 0.90                                                                                          // 0% | Доставка
Відхилення від цілі OTD = [% вчасно (OTD)] - [Ціль OTD]                                                  // +0.0%;-0.0% | Доставка

Днів доставки факт =
AVERAGEX (
    CALCULATETABLE ( VALUES ( 'fЗамовлення'[OrderId] ), 'fЗамовлення'[IsShipped] = 1 ),
    CALCULATE ( MAX ( 'fЗамовлення'[DaysReal] ) )
)                                                                                                        // 0.00 | Доставка

Днів доставки план =
AVERAGEX (
    CALCULATETABLE ( VALUES ( 'fЗамовлення'[OrderId] ), 'fЗамовлення'[IsShipped] = 1 ),
    CALCULATE ( MAX ( 'fЗамовлення'[DaysScheduled] ) )
)                                                                                                        // 0.00 | Доставка

Відхилення днів = [Днів доставки факт] - [Днів доставки план]                                            // +0.00;-0.00 | Доставка

Середнє запізнення, днів =
AVERAGEX (
    CALCULATETABLE ( VALUES ( 'fЗамовлення'[OrderId] ), 'fЗамовлення'[IsLate] = 1 ),
    CALCULATE ( MAX ( 'fЗамовлення'[DelayDays] ) )
)                                                                                                        // 0.00 | Доставка

Продажі під ризиком = CALCULATE ( [Продажі], 'fЗамовлення'[IsLate] = 1 )                                 // $#,0 | Доставка
Частка продажів під ризиком = DIVIDE ( [Продажі під ризиком], [Продажі] )                                 // 0.0% | Доставка

// ---------- 4. Товари ----------
Товари = DISTINCTCOUNT ( 'fЗамовлення'[ProductId] )                                                      // #,0 | Товари
Частка продажів % = DIVIDE ( [Продажі], CALCULATE ( [Продажі], ALLSELECTED ( 'дТовари' ) ) )             // 0.0% | Товари

Кумулятивна частка % =
VAR _cur = [Продажі]
VAR _all = ALL ( 'дТовари'[ProductName] )    // знімає топ-N і вісь візуала; зрізи сторінки й інші колонки дТовари діють
RETURN
    DIVIDE (
        SUMX ( FILTER ( _all, [Продажі] >= _cur ), [Продажі] ),
        CALCULATE ( [Продажі], _all )
    )                                                                                                    // 0.0% | Товари

Прибуток на одиницю = DIVIDE ( [Прибуток], [Одиниці] )                                                   // $#,0.00 | Товари

// ---------- 5. Клієнти ----------
Клієнти = DISTINCTCOUNT ( 'fЗамовлення'[CustomerId] )                                                    // #,0 | Клієнти
Продажі на клієнта = DIVIDE ( [Продажі], [Клієнти] )                                                     // $#,0 | Клієнти
Замовлень на клієнта = DIVIDE ( [Замовлення], [Клієнти] )                                                // 0.00 | Клієнти

Повторні клієнти =
COUNTROWS (
    FILTER ( VALUES ( 'fЗамовлення'[CustomerId] ), CALCULATE ( DISTINCTCOUNT ( 'fЗамовлення'[OrderId] ) ) > 1 )
)                                                                                                        // #,0 | Клієнти

% повторних клієнтів = DIVIDE ( [Повторні клієнти], [Клієнти] )                                          // 0.0% | Клієнти

Нові клієнти =
VAR _start = MIN ( 'Календар'[Date] )
VAR _end = MAX ( 'Календар'[Date] )
RETURN
    COUNTROWS (
        FILTER (
            VALUES ( 'fЗамовлення'[CustomerId] ),
            VAR _first = CALCULATE ( MIN ( 'fЗамовлення'[OrderDate] ), ALL ( 'Календар' ) )
            RETURN _first >= _start && _first <= _end
        )
    )                                                                                                    // #,0 | Клієнти

// ---------- 6. Ризики ----------
Підозрілі замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[IsFraud] = 1 )                            // #,0 | Ризики
% підозрілих = DIVIDE ( [Підозрілі замовлення] + 0, [Замовлення] )                                       // 0.00% | Ризики   (+0: 0% замість порожнього там, де замовлення є)
Сума підозрілих = CALCULATE ( [Продажі], 'fЗамовлення'[IsFraud] = 1 )                                    // $#,0 | Ризики
Скасовані замовлення = CALCULATE ( [Замовлення], 'fЗамовлення'[IsCanceled] = 1 )                         // #,0 | Ризики
% скасованих = DIVIDE ( [Скасовані замовлення], [Замовлення] )                                           // 0.00% | Ризики
Сума скасованих = CALCULATE ( [Продажі], 'fЗамовлення'[IsCanceled] = 1 )                                 // $#,0 | Ризики
Збиткові позиції = CALCULATE ( [Позиції], 'fЗамовлення'[Profit] < 0 )                                    // #,0 | Ризики
% збиткових позицій = DIVIDE ( [Збиткові позиції], [Позиції] )                                           // 0.0% | Ризики
Збиток = CALCULATE ( [Прибуток], 'fЗамовлення'[Profit] < 0 )                                             // $#,0 | Ризики
