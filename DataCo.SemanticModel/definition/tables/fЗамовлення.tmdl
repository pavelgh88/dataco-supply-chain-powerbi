	/// Порядок статусів доставки для легенди: запізнення, вчасно, достроково, скасовано
	column DeliveryStatusSort
		dataType: int64
		isHidden
		lineageTag: 76654913-0f9e-4b3d-ae25-bde93c2fb3c2
		summarizeBy: none
		sourceColumn: DeliveryStatusSort

	partition fЗамовлення = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "f_orders.csv"), [Delimiter=",", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"OrderItemId", Int64.Type}, {"OrderId", Int64.Type}, {"OrderDate", type date}, {"ShipDate", type date}, {"CustomerId", Int64.Type}, {"ProductId", Int64.Type}, {"GeoKey", Int64.Type}, {"ShipModeKey", Int64.Type}, {"PaymentType", type text}, {"OrderStatus", type text}, {"DeliveryStatus", type text}, {"IsShipped", Int64.Type}, {"IsLate", Int64.Type}, {"IsFraud", Int64.Type}, {"IsCanceled", Int64.Type}, {"DaysReal", Int64.Type}, {"DaysScheduled", Int64.Type}, {"DelayDays", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"GrossSales", type number}, {"Discount", type number}, {"DiscountRate", type number}, {"NetSales", type number}, {"Profit", type number}}, "en-US"),
				    StatusSort = Table.AddColumn(Typed, "DeliveryStatusSort", each
				        if [DeliveryStatus] = "Late delivery" then 1
				        else if [DeliveryStatus] = "Shipping on time" then 2
				        else if [DeliveryStatus] = "Advance shipping" then 3
				        else if [DeliveryStatus] = "Shipping canceled" then 4
				        else 9, Int64.Type)
				in
				    StatusSort

