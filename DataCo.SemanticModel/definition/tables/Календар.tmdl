/// Календар 2015-01-01..2018-12-31; IsCorePeriod = 1 до 2017-10-31
table Календар
	lineageTag: bc574be5-1332-4a54-8cd2-0fe1cbb00146
	dataCategory: Time

	column Date
		dataType: dateTime
		isUnique
		isKey
		formatString: yyyy-mm-dd
		lineageTag: bb4f0ae9-07dd-4e9c-8ec8-9e95f3079689
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		lineageTag: 469bd8fc-b322-4f5b-9a73-86458a6a210a
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 7362c54e-6e12-46cf-a353-06b6d5097a91
		summarizeBy: none
		sourceColumn: Quarter

	column MonthNo
		dataType: int64
		lineageTag: da67aa70-1ecc-4b94-8464-f65a48d26922
		summarizeBy: none
		sourceColumn: MonthNo

	column Month
		dataType: string
		lineageTag: 29bd0340-e7c9-4820-9525-4ec551044c29
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo

	column YearMonth
		dataType: string
		lineageTag: af64e6eb-235f-41f5-8c7f-0171d707e399
		summarizeBy: none
		sourceColumn: YearMonth

	column WeekdayNo
		dataType: int64
		lineageTag: 577c5cfe-0df8-4e56-8ff1-d11180717fea
		summarizeBy: none
		sourceColumn: WeekdayNo

	column Weekday
		dataType: string
		lineageTag: 7a556236-eccc-4cc7-b14e-1d3b9c664a65
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: WeekdayNo

	column IsWeekend
		dataType: int64
		lineageTag: 13271df0-f716-468a-ab9f-c2e29afd2136
		summarizeBy: none
		sourceColumn: IsWeekend

	column IsCorePeriod
		dataType: int64
		lineageTag: 3ad90a9a-74fa-418b-821e-1bd6565cc5a7
		summarizeBy: none
		sourceColumn: IsCorePeriod

	/// Перший день місяця — безперервна вісь для ліній по місяцях
	column MonthStart = DATE ( [Year], [MonthNo], 1 )
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: c83dce06-bcee-4429-9549-44e4b8ac295a
		summarizeBy: none

	/// Year > Quarter > Month
	hierarchy Рік-Квартал-Місяць
		lineageTag: c56f8666-f4c0-4c56-9772-4cc893a63458

		level Year
			lineageTag: df9525c0-25e3-4b64-ac03-b8f00d9a58a3
			column: Year

		level Quarter
			lineageTag: 05c852d9-13ba-44f2-b8ee-d6cb22746cc2
			column: Quarter

		level Month
			lineageTag: 3e4232bc-c4a7-4a3a-bb4e-e389b1d218db
			column: Month

	partition Календар = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "d_calendar.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNo", Int64.Type}, {"Month", type text}, {"YearMonth", type text}, {"WeekdayNo", Int64.Type}, {"Weekday", type text}, {"IsWeekend", Int64.Type}, {"IsCorePeriod", Int64.Type}}, "en-US")
				in
				    Typed

