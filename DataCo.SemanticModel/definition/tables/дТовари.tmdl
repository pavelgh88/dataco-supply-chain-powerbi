/// Довідник товарів з класами ABC/XYZ
table дТовари
	lineageTag: 30a65f82-c461-4b02-9ce3-20ac834349e2

	column ProductId
		dataType: int64
		lineageTag: e1eef8c6-be43-4a82-8147-99b7112610b6
		summarizeBy: none
		sourceColumn: ProductId

	column ProductName
		dataType: string
		lineageTag: fd0ef87b-5583-4076-a519-7ea2b2c4e921
		summarizeBy: none
		sourceColumn: ProductName

	column Category
		dataType: string
		lineageTag: ee0d4b45-6c1c-4137-88b9-a4212394ba93
		summarizeBy: none
		sourceColumn: Category

	column Department
		dataType: string
		lineageTag: c7c9669d-02dc-46b0-b2d1-a3c6964766d3
		summarizeBy: none
		sourceColumn: Department

	column ABC
		dataType: string
		lineageTag: 7998ac1b-afeb-4310-8293-fd82b3804389
		summarizeBy: none
		sourceColumn: ABC

	column ActiveMonths
		dataType: int64
		lineageTag: 835313a0-9d52-4ebf-bc72-1353fb49e51c
		summarizeBy: none
		sourceColumn: ActiveMonths

	column DemandCV
		dataType: double
		lineageTag: 9a65f273-390c-4092-924e-a2cb5b99e787
		summarizeBy: none
		sourceColumn: DemandCV

	column XYZ
		dataType: string
		lineageTag: c5ec9635-c4e8-4f71-8bb7-1e059bed413c
		summarizeBy: none
		sourceColumn: XYZ

	column ABCXYZ
		dataType: string
		lineageTag: eb341ebb-9753-4ba1-8dd8-3463f56bc804
		summarizeBy: none
		sourceColumn: ABCXYZ

	/// Department > Category > ProductName
	hierarchy 'Товарна ієрархія'
		lineageTag: 1c03d503-5206-49d9-aafc-e412b4fcbac9

		level Department
			lineageTag: 12bdf925-2199-468d-bf19-49dae428adee
			column: Department

		level Category
			lineageTag: 688017ae-4927-47f4-b684-cf2201e967d3
			column: Category

		level ProductName
			lineageTag: c618b5b5-469b-4ecf-928c-860fe6979270
			column: ProductName

	partition дТовари = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "d_products.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"ProductId", Int64.Type}, {"ProductName", type text}, {"Category", type text}, {"Department", type text}, {"ABC", type text}, {"ActiveMonths", Int64.Type}, {"DemandCV", type number}, {"XYZ", type text}, {"ABCXYZ", type text}}, "en-US")
				in
				    Typed

