{
  "name": "DataCo",
  "dataColors": ["#1F3A5F", "#3D7EAA", "#7FB3D5", "#F2A541", "#5B8E7D", "#A0A4AB", "#C97B63", "#6C5B7B"],
  "foreground": "#1E2329",
  "foregroundNeutralSecondary": "#5F6670",
  "foregroundNeutralTertiary": "#A0A4AB",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "backgroundNeutral": "#E3E7ED",
  "tableAccent": "#1F3A5F",
  "good": "#2E8B57",
  "neutral": "#F2A541",
  "bad": "#D64550",
  "maximum": "#1F3A5F",
  "center": "#7FB3D5",
  "minimum": "#F4F6F9",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1E2329" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1E2329" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F6670" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1E2329" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E7ED" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 12, "right": 12 }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#1E2329" } } }]
      }
    }
  }
}
